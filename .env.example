# Copy to .env.local (never committed). Every value is optional: without them the site
# shows the four series with real zeros and "Set at deployment" for the addresses.

# The SeriesFactory you deployed on Robinhood Chain (chain id 4663).
NEXT_PUBLIC_FACTORY_ADDRESS=
# Public site URL (metadata).
NEXT_PUBLIC_SITE_URL=https://halveshq.fun
# Optional: WalletConnect project id (adds the QR option to the connect sheet).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Local hardhat node only (scripts/play-ui.mjs):
# NEXT_PUBLIC_CHAIN_ID=31337
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8905
# NEXT_PUBLIC_EXPLORER_URL=http://127.0.0.1:8905
# NEXT_PUBLIC_LOCAL_TOKENS=SPY=0x...
